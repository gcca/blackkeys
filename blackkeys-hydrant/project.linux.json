{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "lib" ],
  "dependencies": [ ],
  "authors": [ "Cristhian Gonzales Castillo <yo@gcca.dev>" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "script-dir": ".",
  "exec": [ ],
  "cc": "clang",
  "cflags": "-std=c23",
  "c-include-dirs": [ "3rdparty", "3rdparty/argon2/include" ],
  "link-args": [
    "-std=c23",
    "-I3rdparty",
    "-I3rdparty/argon2/include",
    "-I3rdparty/argon2/src",
    "-I/usr/include",
    "3rdparty/cacheshim.c",
    "3rdparty/argon2/src/argon2.c",
    "3rdparty/argon2/src/core.c",
    "3rdparty/argon2/src/encoding.c",
    "3rdparty/argon2/src/ref.c",
    "3rdparty/argon2/src/thread.c",
    "3rdparty/argon2/src/blake2/blake2b.c",
    "3rdparty/mqshim.c",
    "build/fbufs.o",
    "-pthread",
    "-lstdc++",
    "-L/usr/lib"
  ],
  "linked-libraries": [ "memcached", "hashkit", "rabbitmq" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "blackkeys-hydrant": {
      "type": "executable",
    },
  },
  "cpu": "generic",
  "opt": "O0"
}
